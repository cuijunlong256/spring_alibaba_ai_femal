<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>

    <context id="MySqlContext" targetRuntime="MyBatis3">
        <!-- 自动给关键字添加分隔符（MySQL 反引号） -->
        <property name="beginningDelimiter" value="`"/>
        <property name="endingDelimiter" value="`"/>

        <!-- 注释生成器：取消所有自动生成的注释 -->
        <commentGenerator>
            <property name="suppressAllComments" value="true"/>
            <property name="suppressDate" value="true"/>
        </commentGenerator>

        <!-- 数据库连接信息（保留 tinyInt1isBit=false 防止驱动层误判） -->
        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/mental_health_assistant?useSSL=false&amp;serverTimezone=Asia/Shanghai&amp;tinyInt1isBit=false"
                        userId="root"
                        password="123456">
            <property name="nullCatalogMeansCurrent" value="true"/>
        </jdbcConnection>

        <!-- Java 类型解析器 -->
        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
            <!-- 使用 JSR310 时间类型 (LocalDate, LocalDateTime) -->
            <property name="useJSR310Types" value="true"/>
        </javaTypeResolver>

        <!-- 实体类（POJO）生成配置 -->
        <javaModelGenerator targetPackage="com.atguigu.study.domain"
                            targetProject="src/main/java">
            <property name="enableSubPackages" value="true"/>
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <!-- Mapper XML 映射文件生成配置 -->
        <sqlMapGenerator targetPackage="mapper"
                         targetProject="src/main/resources">
            <property name="enableSubPackages" value="true"/>
        </sqlMapGenerator>

        <!-- Mapper 接口（DAO）生成配置 -->
        <javaClientGenerator type="XMLMAPPER"
                             targetPackage="com.atguigu.study.mapper"
                             targetProject="src/main/java">
            <property name="enableSubPackages" value="true"/>
        </javaClientGenerator>

